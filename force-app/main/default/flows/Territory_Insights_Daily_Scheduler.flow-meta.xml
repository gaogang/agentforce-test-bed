<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Launch_Agent</name>
        <label>Launch Territory Insights Agent</label>
        <locationX>50</locationX>
        <locationY>500</locationY>
        <actionName>LaunchTerritoryInsightsAgent</actionName>
        <actionType>apex</actionType>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Loop_Over_Territories</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>territoryId</name>
            <value>
                <elementReference>Loop_Over_Territories.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>reportDate</name>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputParameters>
        <nameSegment>LaunchTerritoryInsightsAgent</nameSegment>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Scheduled flow that fires once per day at 06:00. Queries all active Territory2 records and calls LaunchTerritoryInsightsAgent for each one.</description>
    <interviewLabel>Territory Insights Daily Scheduler {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Territory Insights Daily Scheduler</label>
    <loops>
        <name>Loop_Over_Territories</name>
        <label>Loop Over Territories</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <collectionReference>Get_Active_Territories</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Launch_Agent</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Active_Territories</name>
        <label>Get Active Territories</label>
        <locationX>50</locationX>
        <locationY>200</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Over_Territories</targetReference>
        </connector>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Territory2</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Active_Territories</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-07-24</startDate>
            <startTime>06:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
